# Copy to .env.local for local dev; set the same keys in Vercel → Project → Settings → Environment Variables.

# Waitlist (required for the "Join waitlist" form to work).
# Resend → API Keys (Full or Sending access) and Resend → Audiences → copy the audience ID.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Public URLs (defaults shown). Never hardcode domains in code (see ADR-015).
# Vercel URL until foyr.online is bought (ADR-021, docs/domain-switch.md).
NEXT_PUBLIC_SITE_URL=https://foyrai.vercel.app
NEXT_PUBLIC_DASHBOARD_URL=https://app.foyr.online

# Optional links: each one is hidden on the site until it is set.
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
# "Edit on GitHub" in the docs, e.g. https://github.com/<org>/<repo>/edit/main/site
NEXT_PUBLIC_DOCS_EDIT_URL=

# Waitlist emails (optional).
# Where "New waitlist sign-up" emails go (server-only). Unset = the founder address in
# app/actions/waitlist.ts (temporary, ADR-021).
WAITLIST_NOTIFY_EMAIL=
# Sender for waitlist emails, e.g. "Foyr <hello@mail.foyr.online>". Set only after the domain is
# verified in Resend; this also turns on the welcome email to the person who joined.
WAITLIST_FROM_EMAIL=
